# OCR Gateway 示例环境变量。将本文件复制为 .env 并填入真实值；真实凭证 MUST NOT 进仓。

# 构建期镜像/包索引（Docker 构建使用；离线环境必填，例如 https://pypi.tuna.tsinghua.edu.cn/simple）
UV_DEFAULT_INDEX=
# 构建期 npm 索引（前端阶段使用；与 UV_DEFAULT_INDEX 同构：空=默认源，非空=指定镜像）
NPM_REGISTRY=
# 构建期 Debian 镜像（runtime 安装 libgomp1 用；离线环境可指向 https://mirrors.tuna.tsinghua.edu.cn）
APT_MIRROR=

MASTER_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
ADMIN_PASSWORD=change-me-please
# 宿主机监听端口（仅 docker compose 端口映射使用；容器内固定 8000）
HOST_PORT=8000
# 宿主机绑定 IP（仅 docker compose 端口映射使用）；留空或 127.0.0.1 仅本机可访问，
# 改为 0.0.0.0 则对外监听（请自行评估鉴权与网络暴露）
HOST_IP=127.0.0.1
# 宿主机 SQLite 数据目录；容器内由 docker-compose.yml 覆盖为 /data（绝对路径）
DATA_DIR=./data
# 留空即从 DATA_DIR 推导；容器内 compose 强制为空
DATABASE_URL=
# 面板静态产物目录（DIST=构建产物，区别于 DIR=数据目录）；容器内由镜像设为 /app/static
FRONTEND_DIST=
DEFAULT_TIMEOUT_MS=8000
REQUEST_DEADLINE_MS=20000
# 本地 OCR（可选 extra local；发布镜像已内置）。开关的运行时值由设置页持久化，
# 这里的 LOCAL_OCR_ENABLED 只作为首次启动/无持久化值时的默认。
LOCAL_OCR_ENABLED=false
LOCAL_OCR_MAX_CONCURRENCY=1
LOCAL_OCR_TIMEOUT_MS=30000
# 启动/重建池的预热预算；繁忙宿主机（含 cpus 限制）可调大，如 30000
LOCAL_OCR_WARMUP_TIMEOUT_MS=10000
LOCAL_OCR_RESERVE_MS=5000
LOCAL_OCR_MIN_BUDGET_MS=1000
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=1000
MAX_UPLOAD_BYTES=10485760
# 解码前像素上限与全局并发（2C4G 建议默认值；更大机器可上调）
MAX_IMAGE_PIXELS=25000000
MAX_CONCURRENT_REQUESTS=4
URL_FETCH_TIMEOUT_SECONDS=10
URL_FETCH_MAX_BYTES=10485760
SESSION_TTL_SECONDS=43200
# 反代后启用：登录限速按 X-Forwarded-For/X-Real-IP 识别 IP；同时让 HTTPS 反代的会话 cookie 带上 Secure
TRUST_PROXY_HEADERS=false
# /docs、/redoc、/openapi.json 开关。默认 false（生产关闭）；本地开发设为 true 保留调试界面
DOCS_ENABLED=false
# 容器资源上限（docker compose 使用；2C4G 建议默认值）
MEM_LIMIT=2g
CPUS=2.0
PIDS_LIMIT=512
LOG_LEVEL=INFO
